# ==================== ТЕЛЕГРАМ БОТ ====================
BOT_TOKEN=токен_бота

# Секретный пароль для авторизации админа (/admin пароль)
ADMIN_PASSWORD=ASTREYKIRILL

# ID администраторов Telegram через запятую
ADMIN_IDS=574947799

# ID администраторов VK (для уведомлений в ВК)
ADMIN_VK_IDS=140519864

# ==================== GIGACHAT API (СБЕРБАНК) ====================
# Готовый AUTH KEY (Base64) из Sber Studio:
GIGACHAT_AUTH_KEY=твой_ключ

# ИЛИ Client ID и Client Secret отдельно:
GIGACHAT_CLIENT_ID=твой_client_id
GIGACHAT_CLIENT_SECRET=твой_client_secret

# Область доступа
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ==================== VK БОТ ====================
VK_TOKEN=твой_vk_token
VK_GROUP_ID=твой_group_id

# ==================== БАЗА ДАННЫХ ====================
# Для локальной разработки — SQLite:
DATABASE_PATH=/data/astreybot.db

# На Railway — PostgreSQL (автоматически выдаётся платформой):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
